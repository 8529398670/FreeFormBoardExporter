# Copy to .env and edit. Read by ./dockerRun.sh and ./boardctl alike.
# Anything already set in your environment wins over what is written here.

# Where the export lives on this host. Absolute or relative to this directory.
# This is the directory that gets mounted; it is never copied into the image.
BOARDS_DIR=./boards

# Boards named in .boardignore are exported here instead of into BOARDS_DIR.
# This directory is never mounted into the container, which is what keeps those
# boards out of the served site and out of its index.html.
IGNORED_DIR=./boards-ignored
IGNORE_FILE=.boardignore

# Which host address to publish on. 127.0.0.1 means this machine only.
# Use 0.0.0.0 to reach it from your phone or another machine on the network,
# and set FREEFORM_AUTH as well if you do.
BIND_ADDR=127.0.0.1
PORT=9384

# Optional HTTP basic auth, as user:password. Blank disables it.
# Basic auth sends the password in the clear, so it is only meaningful behind
# HTTPS or a private tunnel (Tailscale, WireGuard, an SSH forward).
FREEFORM_AUTH=

# How long a browser may reuse images and video without asking again. Board
# pages and layout data are always revalidated, so a refresh shows up at once
# regardless of this.
FREEFORM_ASSET_MAX_AGE=300

# Image and container names.
IMAGE=freeform-boards
CONTAINER=freeform-boards
